# Puertos expuestos en localhost
BACKEND_PORT=8000
FRONTEND_PORT=80

# Rutas internas dentro de los contenedores
DATABASE_PATH=/app/data/db/math2pix.sqlite
UPLOADS_PATH=/app/data/uploads

# URLs internas (nombre del contenedor = hostname en la red Docker)
YOLO_SERVICE_URL=http://yolo:8000
OCR_SERVICE_URL=http://ocr:8000

# Margen de seguridad al recortar bounding boxes antes del OCR (RF-04), en píxeles
BBOX_MARGIN_PX=10